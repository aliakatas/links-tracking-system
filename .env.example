# Copy to .env and adjust for your local environment.
POSTGRES_USER=system_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=links_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host directory for Postgres data (bind mount); defaults to ./.pgdata
POSTGRES_DATA_DIR=./.pgdata
DATABASE_URL=postgresql+psycopg://system_user:change-me@localhost:5432/links_tracker
# Host port for the API container
API_PORT=8000
# Backend the frontend proxies /api/* to. Compose default: http://links-api:8000
# API_URL=http://links-api:8000
