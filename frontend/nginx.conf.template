server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # The browser only ever talks to this server; /api/* is forwarded to the
    # backend at API_URL. That keeps the frontend independent of where the API
    # runs and avoids CORS configuration on the backend.
    location /api/ {
        # Using a variable in proxy_pass makes nginx re-resolve the backend
        # hostname at request time, so a restarted backend (new IP) or a DNS
        # change is picked up without restarting this container.
        # NGINX_LOCAL_RESOLVERS is set by the image from /etc/resolv.conf.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
    }
}
